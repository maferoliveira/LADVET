# Supabase PostgreSQL
# DATABASE_URL: Transaction pooler (porta 6543), com parâmetros adequados ao Supabase.
DATABASE_URL="postgresql://postgres:[SENHA]@[HOST]:6543/postgres?pgbouncer=true"

# DIRECT_URL: Session pooler (porta 5432), usado pelo Prisma CLI/configuração.
DIRECT_URL="postgresql://postgres:[SENHA]@[HOST]:5432/postgres"

# Gere um segredo longo e aleatório para produção.
SECRET_JWT="COLOQUE_UM_SEGREDO_FORTE_AQUI"

# Mesmo Client ID configurado no Google Cloud Console.
GOOGLE_CLIENT_ID="SEU_GOOGLE_CLIENT_ID"

# Código de validação da clínica, se a implementação do projeto utilizar esta variável.
CRMV_DEMO_CODE="DEFINIR_O_CODIGO_CONFIGURADO_NO_PROJETO"

# Domínio do frontend publicado na Vercel.
FRONTEND_URL="https://SEU-FRONTEND.vercel.app"

NODE_ENV="production"
