generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id           Int         @id @default(autoincrement())
  nome         String
  email        String      @unique
  senha        String
  telefone     String
  cidade       String
  cep          String?
  endereco     String?
  bairro       String?
  numero       String?
  tipo_usuario tipoUsuario

  //apenas adotante
  residencia   String?
  espaco       String?
  rotina       String?

  //apenas clinica
  crmv         String?
  validado     Boolean @default(true)

  adocoes Adocao[]
  animais Animal[]
}

model Animal {
  id           Int          @id @default(autoincrement())
  nome         String
  especie      String
  raca         String @default("Não informado")
  idade        Int
  sexo         String
  porte        String @default("Não informado")
  temperamento String?
  foto         String
  status       statusAnimal @default(DISPONIVEL)

  usuarioID Int
  usuario   Usuario @relation(fields: [usuarioID], references: [id])

  adocoes Adocao[]
  vacinas Vacina[]
}

model Vacina {
  id           Int      @id @default(autoincrement())
  nome         String
  dataAplicacao DateTime
  proximaDose  DateTime?
  veterinario  String
  lote         String

  animalID Int
  animal   Animal @relation(fields: [animalID], references: [id])
}

model Adocao {
  id              Int          @id @default(autoincrement())
  moradia         String
  temQuintal      Boolean
  experiencia     String?
  tempoDisponivel String
  status          statusAdocao @default(PENDENTE)

  animalID   Int
  adotanteID Int
  animal     Animal  @relation(fields: [animalID], references: [id])
  adotante   Usuario @relation(fields: [adotanteID], references: [id])
}

enum tipoUsuario {
  ADOTANTE
  CLINICA
}

enum statusAnimal {
  DISPONIVEL
  EM_PROCESSO
  ADOTADO
}

enum statusAdocao {
  PENDENTE
  APROVADA
  RECUSADA
}
